{
  "version": 1,
  "author": "Osifo Anosike",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp"
    },
    {
      "type": "wokwi-led",
      "id": "led",
      "top": -120,
      "left": 20,
      "attrs": {"color": "green", "flip": "-1" }
    },
    {
      "type": "wokwi-resistor",
      "id": "resistor",
      "top": -50,
      "left": 0,
      "rotate": 90,
      "attrs": {"value": "100"}
    }
  ],
  "connections": [
    ["led:A", "resistor:1", "red"],
    ["led:C", "esp:GND.2", "black"],
    ["resistor:2", "esp:12", "red"],
    [
      "esp:TX",
      "$serialMonitor:RX",
      ""
    ],
    [
      "esp:RX",
      "$serialMonitor:TX",
      ""
    ]
  ]
}